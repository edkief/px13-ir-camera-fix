# Maintainer: Ed Kieffer <17440999+edkief@users.noreply.github.com>
# Based on howdy-git by SelfRef <arch@selfref.dev>

_pkgbase=howdy
_fixname=px13-ir-camera-fix
pkgname=howdy-px13-git
pkgver=r592.d3ab993.px13.r2.9fb349e
pkgrel=1
pkgdesc="Windows Hello style facial authentication for Linux, with the MSXU IR recorder for the ASUS ProArt PX13 IR camera"
arch=('x86_64')
url="https://github.com/edkief/px13-ir-camera-fix"
license=('MIT')
makedepends=('git' 'meson' 'ninja' 'cmake')
depends=('libinih' 'libevdev' 'python' 'python-dlib' 'python-opencv' 'python-numpy')
optdepends=('gtk3: howdy-gtk'
            'python-gobject: howdy-gtk'
            'python-cairo: howdy-gtk')
provides=('howdy')
conflicts=('howdy' 'howdy-git')
backup=('etc/howdy/config.ini')
install=howdy-px13.install
source=(
	"howdy::git+https://github.com/boltgolt/howdy.git"
	"$_fixname::git+https://github.com/edkief/px13-ir-camera-fix.git"
	"https://github.com/davisking/dlib-models/raw/master/dlib_face_recognition_resnet_model_v1.dat.bz2"
	"https://github.com/davisking/dlib-models/raw/master/mmod_human_face_detector.dat.bz2"
	"https://github.com/davisking/dlib-models/raw/master/shape_predictor_5_face_landmarks.dat.bz2"
	"polkit-agent-helper-howdy.conf"
)
sha256sums=('SKIP'
            'SKIP'
            'abb1f61041e434465855ce81c2bd546e830d28bcbed8d27ffbe5bb408b11553a'
            'db9e9e40f092c118d5eb3e643935b216838170793559515541c56a2b50d9fc84'
            '6e787bbebf5c9efdb793f6cd1f023230c4413306605f24f299f12869f95aa472'
            '2283fc4684751caa41e87023755bba5c3468475b6ed632b13a4ac6e9c748c512')

pkgver() {
	local howdy fix
	howdy=$(cd "$_pkgbase" && printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)")
	fix=$(cd "$_fixname" && printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)")
	printf "%s.px13.%s" "$howdy" "$fix"
}

prepare() {
	cd "$srcdir/$_pkgbase"
	patch -Np1 -i "$srcdir/$_fixname/patches/howdy-msxu.patch"
	patch -Np1 -i "$srcdir/$_fixname/patches/howdy-test-opencv5-hist.patch"
	patch -Np1 -i "$srcdir/$_fixname/patches/howdy-msxu-package.patch"
	install -m644 "$srcdir/$_fixname/msxu_reader.py" howdy/src/recorders/msxu_reader.py
}

build() {
	cd "$srcdir"
	arch-meson "$_pkgbase" build
	meson compile -C build
}

package() {
	cd "$srcdir"
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$_pkgbase/howdy/src/config.ini" "$pkgdir/etc/howdy/config.ini"
	install -Dm644 "$_pkgbase/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$_fixname/FINDINGS.md" "$pkgdir/usr/share/doc/$pkgname/FINDINGS.md"

	install -Dm644 -t "$pkgdir/usr/share/dlib-data" *.dat

	# Workaround for polkit 127+ breaking howdy (boltgolt/howdy#1077)
	install -Dm644 polkit-agent-helper-howdy.conf \
		"$pkgdir/usr/lib/systemd/system/polkit-agent-helper@.service.d/10-howdy.conf"
}
