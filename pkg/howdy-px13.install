post_install() {
	echo '[SETUP] 1. config.ini defaults to the PX13 IR camera and the msxu recorder.'
	echo '        Check device_path with `v4l2-ctl --list-devices` if howdy cannot find the camera.'
	echo '[SETUP] 2. Test settings with `sudo howdy test` (debug: `sudo HOWDY_MSXU_DEBUG=1 howdy test`)'
	echo '[SETUP] 3. Add face model with `sudo howdy add`'
	echo '[SETUP] 4. Add PAM policy `auth sufficient pam_howdy.so` to e.g. top of `/etc/pam.d/system-auth` (global auth)'
	echo '[INFO] Background on the PX13 IR camera: /usr/share/doc/howdy-px13-git/FINDINGS.md'
	echo '[INFO] Arch Wiki page: https://wiki.archlinux.org/title/Howdy'
}

post_upgrade() {
	if ! grep -Eq '^recording_plugin[[:space:]]*=[[:space:]]*msxu' /etc/howdy/config.ini 2>/dev/null; then
		echo '[NOTE] /etc/howdy/config.ini does not use the msxu recorder.'
		echo '       Set `recording_plugin = msxu` (see /etc/howdy/config.ini.pacnew for the new defaults).'
	fi
}
